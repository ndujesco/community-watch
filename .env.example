# FloodWatch Web — environment variables
# Copy to .env and adjust:  cp .env.example .env

# Base URL of the FloodWatch API.
# Local dev defaults to http://localhost:8000 if this is unset.
# In production set this to your deployed backend, e.g. a Render URL.
VITE_API_URL=http://localhost:8000

# Optional explicit WebSocket URL. If omitted it is derived from VITE_API_URL
# (http -> ws, https -> wss) with the /ws path appended.
# Production example: wss://floodwatch-api.onrender.com/ws
# VITE_WS_URL=ws://localhost:8000/ws
